{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soft Factory",
  "version": "0.1.7",
  "identifier": "com.ernesto.desktop-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Soft Factory",
        "maximized": true,
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#111110"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVENkNDQjg0MkI1RDg5QTEKUldTaGlWMHJoTXRzWGVsRmgvck5hYVhqL1ZMVmhrZkhZS1JKZGNCa1dNVjhySDE1aTlibThnTTcK",
      "endpoints": [
        "https://github.com/ernesto27/ai-tools/releases/download/desktop-updates/latest.json"
      ]
    }
  }
}
