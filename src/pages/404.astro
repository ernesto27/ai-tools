---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
---

<BaseLayout title="Page not found" noindex>
  <div class="shell error-page">
    <p class="error-number">
      404<span class="brand-period">.</span>
    </p>
    <div class="eyebrow justify-center">A page out of place</div>
    <h1>This note seems to be missing.</h1>
    <p>
      The link may have changed. There are still plenty of good ideas to
      explore.
    </p>
    <a class="button-link" href="/">
      Back to the journal <Icon name="arrow" size={17} />
    </a>
    <p class="mt-5 text-sm">
      Or{" "}
      <a class="text-link" href="/search/">
        search the notebook
      </a>
      .
    </p>
  </div>
</BaseLayout>
